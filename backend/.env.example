SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=replace-with-a-long-random-string

EVENTS_SERVICE_PORT=4001
USER_SERVICE_PORT=4002
VENUE_SERVICE_PORT=4003
NOTIFICATION_SERVICE_PORT=4004
EQUIPMENT_SERVICE_PORT=4005
CHAT_SERVICE_PORT=4006
REGISTRATION_SERVICE_PORT=4007

# Where venue-service, equipment-service and chat-service reach events-service.
EVENTS_SERVICE_URL=http://localhost:4001
# Where events-service reaches user-service (the coordinator list for E2-13/E2-12 assignment)
# and where registration-service reaches it for attendee names.
USER_SERVICE_URL=http://localhost:4002
# Where events-service reaches venue-service and equipment-service (E3-4: are the
# event's venue bookings and equipment settled before it enters Safety Review?)
# and where registration-service reaches venue-service for an event's venue names.
VENUE_SERVICE_URL=http://localhost:4003
EQUIPMENT_SERVICE_URL=http://localhost:4005

# The broker connection (c4_diagrams/RabbitMQ.md section 1). notification-service
# consumes; events-service publishes coordinator.assigned (the first trigger
# migrated off direct REST, per ARD section 1.1). Leave unset in local dev
# without Docker; both sides stay idle (events-service falls back to doing
# nothing — no REST fallback — so this must be set for assignment notifications
# to be delivered).
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Shared secret for service-to-service calls (e.g. notification-service
# resolving role-based recipients via user-service). Separate from
# JWT_SECRET so a leaked value can't forge a user session or vice versa.
INTERNAL_SERVICE_SECRET=change-me
